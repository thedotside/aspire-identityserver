{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Paris",
  "enabledManagers": ["nuget", "github-actions", "npm", "custom.regex"],
  "ignorePaths": ["**/bin/**", "**/obj/**", "artifacts/**", "work/**"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchPackageNames": ["/^Aspire\\./"],
      "groupName": "Aspire"
    },
    {
      "description": "Aspire.Hosting is the floor of the published Hosting package: raise it deliberately. AppHost, testing packages and SDK follow patches.",
      "matchPackageNames": ["Aspire.Hosting"],
      "groupName": "Aspire floor",
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["/^Microsoft\\.AspNetCore\\./"],
      "matchCurrentVersion": "/^10\\./",
      "groupName": "ASP.NET Core",
      "allowedVersions": "/^10\\./"
    },
    {
      "matchPackageNames": ["/^Microsoft\\.AspNetCore\\./"],
      "matchCurrentVersion": "/^11\\./",
      "groupName": "ASP.NET Core 11",
      "allowedVersions": "/^11\\./"
    },
    {
      "description": "Like ASP.NET Core, the Microsoft.Extensions references conditioned per framework keep their family: the net10.0 entries stay on 10.x.",
      "matchPackageNames": ["/^Microsoft\\.Extensions\\./"],
      "matchCurrentVersion": "/^10\\.0\\./",
      "allowedVersions": "/^10\\./"
    },
    {
      "matchPackageNames": ["/^Microsoft\\.Extensions\\./"],
      "matchCurrentVersion": "/^11\\./",
      "allowedVersions": "/^11\\./"
    },
    {
      "description": "global.json keeps the SDK 11 family.",
      "matchDepTypes": ["dotnet-sdk"],
      "allowedVersions": "/^11\\./"
    },
    {
      "description": "The pipelines also install SDK 10 for the net10.0 tests and package consumers: keep that family.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["dotnet-sdk"],
      "allowedVersions": "/^10\\./"
    },
    {
      "description": "The provider's OpenTelemetry packages flow into every AppHost: raise them deliberately, against the OpenTelemetry versions that Aspire.Hosting requires.",
      "matchPackageNames": ["/^OpenTelemetry\\./"],
      "groupName": "OpenTelemetry",
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["/^@commitlint\\//"],
      "groupName": "commitlint"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pipelines\\/renovate\\/action\\.yml$/"],
      "matchStrings": ["--package=renovate@(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ]
}
