<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageVersion Include="Duende.IdentityServer" Version="8.0.10" />
    <PackageVersion
      Include="Microsoft.AspNetCore.Authentication.OpenIdConnect"
      Version="10.0.15"
      Condition="'$(TargetFramework)' != 'net11.0'"
    />
    <PackageVersion
      Include="Microsoft.AspNetCore.Authentication.OpenIdConnect"
      Version="11.0.0"
      Condition="'$(TargetFramework)' == 'net11.0'"
    />
    <PackageVersion
      Include="Microsoft.AspNetCore.Authentication.JwtBearer"
      Version="10.0.15"
      Condition="'$(TargetFramework)' != 'net11.0'"
    />
    <PackageVersion
      Include="Microsoft.AspNetCore.Authentication.JwtBearer"
      Version="11.0.0"
      Condition="'$(TargetFramework)' == 'net11.0'"
    />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion
      Include="Microsoft.Extensions.Http"
      Version="10.0.15"
      Condition="'$(TargetFramework)' != 'net11.0'"
    />
    <PackageVersion
      Include="Microsoft.Extensions.Http"
      Version="11.0.0"
      Condition="'$(TargetFramework)' == 'net11.0'"
    />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.1" />
    <PackageVersion
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="10.0.15"
      Condition="'$(TargetFramework)' != 'net11.0'"
    />
    <PackageVersion
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="11.0.0"
      Condition="'$(TargetFramework)' == 'net11.0'"
    />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
    <!--
      The provider runtime brings these versions into every AppHost. Aspire.Hosting 17.0.0 requires
      OpenTelemetry 1.18.0 or later, so 1.20.1 raises what AppHosts resolve: Renovate asks for
      approval before any further raise.
    -->

    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.342" PrivateAssets="all" />
  </ItemGroup>
</Project>
