<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- API compatibility against the last published version; intended breaks are suppressed. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>11.1.0</PackageValidationBaselineVersion>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TheDotSide.Aspire.IdentityServer.Client</PackageId>
    <Description>Optional, engine-independent OAuth client helpers: configuration binding, RS256 private_key_jwt assertions and an RFC 8693 token-exchange handler for named HTTP clients.</Description>
    <PackageTags>openid-connect;oauth;private-key-jwt;testing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/RsaJwk.cs" Link="RsaJwk.cs" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <InternalsVisibleTo Include="Aspire.IdentityServer.UnitTests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
