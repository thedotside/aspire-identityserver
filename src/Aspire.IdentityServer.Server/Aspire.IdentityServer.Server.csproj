<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UseAppHost>false</UseAppHost>
    <IsPackable>true</IsPackable>
    <PackageId>TheDotSide.Aspire.IdentityServer.Runtime</PackageId>
    <Description>Development identity provider runtime for TheDotSide.Aspire.IdentityServer.Hosting. Duende is restored as a NuGet dependency, not bundled.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/TokenExchangeClaims.cs" Link="TokenExchangeClaims.cs" />
    <Compile Include="../Shared/RuntimeContract.cs" Link="RuntimeContract.cs" />
    <PackageReference Include="Duende.IdentityServer" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
