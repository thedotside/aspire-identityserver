@page
@model Aspire.IdentityServer.Server.Pages.Account.LogoutModel
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><title>Development sign out</title>
@if (Model.AutomaticRedirect) { <script src="/Account/signed-out.js" defer></script> }
</head>
<body><main>
@if (!Model.SignedOut)
{
    <h1>Sign out?</h1>
    <form method="post"><input type="hidden" asp-for="LogoutId" /><button type="submit">Sign out</button></form>
}
else
{
    <h1>Signed out</h1>
    @if (Model.SignOutIFrameUrl is not null) { <iframe title="Sign out notification" src="@Model.SignOutIFrameUrl" hidden></iframe> }
    @if (Model.ReturnUrl is not null) { <a id="return" href="@Model.ReturnUrl">Return to application</a> }
}
</main></body></html>
