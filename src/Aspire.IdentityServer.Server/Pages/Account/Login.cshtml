@page
@model Aspire.IdentityServer.Server.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    var errors = ViewData
        .ModelState.Values.SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Distinct(StringComparer.Ordinal)
        .ToList();
    // A username from login_hint or a refused attempt leaves the password to type. Binding
    // turns a blank username into null.
    var hinted = !string.IsNullOrEmpty(Model.Username);
}
<h1>Sign in</h1>
@if (Model.ClientId is { } application)
{
    <p class="lead">Use a test account to continue to <strong>@application</strong>.</p>
}
else
{
    <p class="lead">Use a test account configured in your AppHost.</p>
}
@if (errors.Count > 0)
{
    <div class="alert" role="alert">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5v5" />
            <path d="M12 16.5h.01" />
        </svg>
        <div>
            @foreach (var error in errors)
            {
                <p>@error</p>
            }
        </div>
    </div>
}
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label asp-for="Username"></label>
        <input asp-for="Username" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus="@(!hinted)" />
    </div>
    <div class="field">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" autocomplete="current-password" required autofocus="@hinted" />
    </div>
    <div class="actions">
        <button class="button button-primary" type="submit" name="Button" value="login">Sign in</button>
        <button class="button button-secondary" type="submit" name="Button" value="cancel" formnovalidate>Cancel</button>
    </div>
</form>
<p class="hint">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5" />
        <path d="M12 7.5h.01" />
    </svg>
    <span>Test accounts are declared in the AppHost with <code>AddTestUser</code> or <code>WithTestUser</code>.</span>
</p>
