@page
@model Aspire.IdentityServer.Server.Pages.Account.MfaModel
@{
    ViewData["Title"] = "Two-step verification";
    var errors = ViewData
        .ModelState.Values.SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Distinct(StringComparer.Ordinal)
        .ToList();
}
<h1>Two-step verification</h1>
@if (Model.ClientId is { } application)
{
    <p class="lead">Enter the code you received to continue to <strong>@application</strong>.</p>
}
else
{
    <p class="lead">Enter the code you received.</p>
}
@if (errors.Count > 0)
{
    <div class="alert" role="alert">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5v5" />
            <path d="M12 16.5h.01" />
        </svg>
        <div>
            @foreach (var error in errors)
            {
                <p>@error</p>
            }
        </div>
    </div>
}
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label asp-for="Code"></label>
        @* One field drawn as one box per digit by site.css: pasting and one-time-code autofill keep working. *@
        <div class="code" data-digits="@Model.CodeLength">
            <input asp-for="Code" maxlength="@Model.CodeLength" inputmode="numeric" autocomplete="one-time-code" spellcheck="false" required autofocus />
            @for (var digit = 0; digit < Model.CodeLength; digit++)
            {
                <span aria-hidden="true"></span>
            }
        </div>
    </div>
    <div class="actions">
        <button class="button button-primary" type="submit" name="Button" value="verify">Verify</button>
        <button class="button button-secondary" type="submit" name="Button" value="cancel" formnovalidate>Cancel</button>
    </div>
</form>
<p class="hint">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5" />
        <path d="M12 7.5h.01" />
    </svg>
    <span>This provider simulates a second factor: the code is declared in the AppHost with <code>WithSimulatedMfa</code>.</span>
</p>
