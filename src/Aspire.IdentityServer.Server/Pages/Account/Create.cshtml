@page
@model Aspire.IdentityServer.Server.Pages.Account.CreateModel
@{
    ViewData["Title"] = "Create an account";
    var errors = ViewData
        .ModelState.Values.SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Distinct(StringComparer.Ordinal)
        .ToList();
}
<h1>Create an account</h1>
@if (Model.ClientId is { } application)
{
    <p class="lead">Create a test account to continue to <strong>@application</strong>.</p>
}
else
{
    <p class="lead">Create a test account.</p>
}
@if (errors.Count > 0)
{
    <div class="alert" role="alert">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5v5" />
            <path d="M12 16.5h.01" />
        </svg>
        <div>
            @foreach (var error in errors)
            {
                <p>@error</p>
            }
        </div>
    </div>
}
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label asp-for="Username"></label>
        <input asp-for="Username" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
    </div>
    <div class="field">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" autocomplete="new-password" required />
    </div>
    @* One field per claim declared with WithSignUp, labelled with the claim type itself. *@
    @for (var i = 0; i < Model.ClaimFields.Count; i++)
    {
        <div class="field">
            <label asp-for="ClaimValues[i]">@Model.ClaimFields[i]</label>
            <input asp-for="ClaimValues[i]" autocomplete="@SignUpForm.Autocomplete(Model.ClaimFields[i])" required />
        </div>
    }
    <div class="actions">
        <button class="button button-primary" type="submit" name="Button" value="create">Create account</button>
        <button class="button button-secondary" type="submit" name="Button" value="cancel" formnovalidate>Cancel</button>
    </div>
</form>
<p class="hint">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5" />
        <path d="M12 7.5h.01" />
    </svg>
    <span>Accounts created here stay in memory until the provider restarts.</span>
</p>
