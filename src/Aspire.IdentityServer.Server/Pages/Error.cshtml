@page
@model Aspire.IdentityServer.Server.Pages.ErrorModel
@{
    ViewData["Title"] = "Request rejected";
}
<div class="status status-danger" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7.5v5" />
        <path d="M12 16.5h.01" />
    </svg>
</div>
<h1>Identity request rejected</h1>
<p class="lead">The provider refused this request and could not return to the application.</p>
@if (Model.Message is { } message)
{
    <dl class="details">
        <dt>Error</dt>
        <dd><code>@message.Error</code></dd>
        @if (!string.IsNullOrWhiteSpace(message.ErrorDescription))
        {
            <dt>Description</dt>
            <dd>@message.ErrorDescription</dd>
        }
        @if (!string.IsNullOrWhiteSpace(message.ClientId))
        {
            <dt>Client</dt>
            <dd><code>@message.ClientId</code></dd>
        }
        @if (!string.IsNullOrWhiteSpace(message.RequestId))
        {
            <dt>Request ID</dt>
            <dd><code>@message.RequestId</code></dd>
        }
    </dl>
}
<p class="hint">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v5" />
        <path d="M12 7.5h.01" />
    </svg>
    <span>Check the client registration in your AppHost, and this provider's logs in the Aspire dashboard.</span>
</p>
