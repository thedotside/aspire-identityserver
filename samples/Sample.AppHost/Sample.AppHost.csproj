    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>aspire-identityserver-sample</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <ProjectReference Include="../../src/Aspire.IdentityServer.Hosting/Aspire.IdentityServer.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../Sample.Api/Sample.Api.csproj" />
    <ProjectReference Include="../Sample.Web/Sample.Web.csproj" />
  </ItemGroup>
  <!-- Project references do not import NuGet buildTransitive assets. -->
